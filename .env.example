# ─────────────────────────────────────────────────────────────────────────────
# NUTRETIUM — variables de entorno
#
# Esto es una PLANTILLA. Los valores reales van en:
#   Netlify → Site configuration → Environment variables
# Nunca en el repositorio.
#
# Las marcadas [OBLIGATORIA EN PRODUCCIÓN] tienen que estar puestas antes de
# abrir la tienda al público. Sin ellas la función correspondiente se niega a
# funcionar (falla cerrado) en vez de tirar de un valor por defecto inseguro.
# ─────────────────────────────────────────────────────────────────────────────


# ─── Redsys ───────────────────────────────────────────────────────────────────

# [OBLIGATORIA EN PRODUCCIÓN] Clave secreta de cifrado (la facilita el banco).
# OJO: la clave de TEST y la de PRODUCCIÓN son DISTINTAS. La de producción te la
# dan al solicitar el "pase a entorno real". Márcala como secreta en Netlify.
REDSYS_SECRET_KEY=

# [OBLIGATORIA EN PRODUCCIÓN] Número de comercio (Ds_Merchant_MerchantCode).
# El que viene aquí es el de PRUEBAS: sustitúyelo por el tuyo real.
REDSYS_MERCHANT_CODE=369551841

# Número de terminal (normalmente "1").
REDSYS_TERMINAL=1

# [OBLIGATORIA EN PRODUCCIÓN] "test" usa el sandbox; "production", la pasarela
# real. Si no se define vale "test", así que MIENTRAS NO LA CAMBIES NO SE COBRA
# NADA DE VERDAD. Cámbiala solo tras validar las pruebas y con la clave real.
REDSYS_ENV=test

# URLs de vuelta del navegador tras el pago. OPCIONALES: si no las pones,
# redsys.js las deriva del dominio de la petición.
URL_OK=
URL_KO=

# URL de notificación servidor-a-servidor (Redsys hace POST del resultado real).
# OPCIONAL: también se deriva del dominio si no se define.
MERCHANT_URL=


# ─── Sesiones ─────────────────────────────────────────────────────────────────

# [OBLIGATORIA EN PRODUCCIÓN] Firma los tokens de sesión. Mínimo 32 caracteres.
# Sin ella, el registro y el login devuelven 503: es preferible a firmar con un
# secreto conocido, que permitiría a cualquiera hacerse pasar por otro usuario.
# Genérala con:  openssl rand -base64 48
# Al cambiarla se cierran las sesiones abiertas (los usuarios entran otra vez).
JWT_SECRET=


# ─── Almacenamiento (Netlify Blobs) ───────────────────────────────────────────

# [OBLIGATORIA EN PRODUCCIÓN] Personal Access Token de Netlify. El runtime de
# este sitio no inyecta el contexto de Blobs, así que sin este token no se
# guardan ni los usuarios, ni los pedidos, ni las reseñas: la web funciona pero
# "Mis pedidos" sale vacío y los pagos no quedan registrados.
# Se crea en: Netlify → User settings → Applications → Personal access tokens
NETLIFY_API_TOKEN=

# SITE_ID la inyecta Netlify automáticamente; no hace falta definirla.


# ─── CORS ─────────────────────────────────────────────────────────────────────

# OPCIONAL. Origen permitido para llamar a las funciones. Si no se define se usa
# la URL del sitio que inyecta Netlify, que es lo correcto en el caso normal.
# Solo hace falta si sirves la web desde un dominio distinto al del sitio.
ALLOWED_ORIGIN=


# ─── Correo ───────────────────────────────────────────────────────────────────

# Netlify no envía correo: hace falta un proveedor. https://resend.com (gratis)
# Sin RESEND_API_KEY no se envía nada, solo queda aviso en los logs.
RESEND_API_KEY=

# Dirección que recibe el aviso de cada pedido pagado.
ORDER_NOTIFICATION_EMAIL=appnutretium@gmail.com

# Remitente. Sin dominio verificado en Resend debe ser onboarding@resend.dev.
# Con nutretium.com verificado puedes usar pedidos@nutretium.com
ORDER_EMAIL_FROM=onboarding@resend.dev

# Dirección que recibe los mensajes del formulario de contacto.
CONTACT_EMAIL=info@nutretium.com
