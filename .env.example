# ─── Redsys Configuration ────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# Set these as environment variables in the Netlify dashboard:
# Site Settings → Environment Variables

# Clave secreta de cifrado (la facilita el banco).
# OJO: la clave de TEST y la de PRODUCCIÓN son DISTINTAS.
# La de producción te la darán al solicitar el "pase a entorno real".
REDSYS_SECRET_KEY=pon-aqui-tu-clave-en-Netlify-NO-en-el-repo

# Número de comercio (Ds_Merchant_MerchantCode). Este es el de TEST.
REDSYS_MERCHANT_CODE=369551841

# Número de terminal (normalmente "1")
REDSYS_TERMINAL=1

# "test" usa el sandbox de Redsys; "production" usa la pasarela real.
# Solo cambiar a "production" tras validar las pruebas Y con la clave real.
REDSYS_ENV=test

# URLs de vuelta del navegador tras el pago (Redsys vuelve por POST → la
# función pago-return redirige a /?pago=ok|ko). OPCIONALES: si no las pones,
# redsys.js las deriva del dominio de la petición automáticamente.
URL_OK=https://your-site.netlify.app/.netlify/functions/pago-return?result=ok
URL_KO=https://your-site.netlify.app/.netlify/functions/pago-return?result=ko

# URL de notificación servidor-a-servidor (Redsys hace POST del resultado real
# aquí). OPCIONAL: también se deriva del dominio si no se define.
MERCHANT_URL=https://your-site.netlify.app/.netlify/functions/redsys-notify

# ─── Auth Configuration ───────────────────────────────────────────────────────
# TODO(seguridad): PENDIENTE de definir en Netlify (no solo aquí).
# Firma los tokens de sesión. Si no existe, el código cae a un secreto por
# defecto que está en el repositorio y permitiría falsificar sesiones.
# Genera una cadena larga y aleatoria y marcala como secreta en Netlify.
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# ─── Admin Configuration ─────────────────────────────────────────────────────
# Bearer token required to call the products admin API (upsert/delete)
ADMIN_SECRET=change-this-to-a-secure-admin-password

# ─── Contact Configuration ───────────────────────────────────────────────────
# Email address to receive contact form notifications (optional)
CONTACT_EMAIL=info@nutretium.com

# ─── Envio de correo (Resend) ────────────────────────────────────────────────
# Netlify no envia correo: hace falta un proveedor. https://resend.com (gratis)
# Sin RESEND_API_KEY no se envia nada (solo queda aviso en los logs).
RESEND_API_KEY=re_tu_clave_de_resend

# Direccion que recibe el aviso de cada pedido pagado
ORDER_NOTIFICATION_EMAIL=appnutretium@gmail.com

# Remitente. Sin dominio verificado en Resend debe ser onboarding@resend.dev.
# Con nutretium.com verificado puedes usar pedidos@nutretium.com
ORDER_EMAIL_FROM=onboarding@resend.dev
