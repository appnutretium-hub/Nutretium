# NUTRETIUM — plantilla de variables de entorno
# Los valores reales se configuran en Netlify → Site configuration → Environment variables.
# Nunca guardes secretos reales en el repositorio.

# ── Redsys ────────────────────────────────────────────────────────────────────
REDSYS_SECRET_KEY=
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=1
REDSYS_ENV=test
URL_OK=
URL_KO=
MERCHANT_URL=
COMMERCE_LIVE=false

# ── Sesiones / Security Core Zero Trust ───────────────────────────────────────
JWT_SECRET=
MFA_ENCRYPTION_KEY=
STAFF_TOTP_SECRETS=
REQUIRE_STAFF_MFA=true
REQUIRE_STAFF_COOKIE=false
REQUIRE_STAFF_CSRF=false
REQUIRE_STAFF_STEP_UP=false
GUEST_ORDER_SECRET=
MAINTENANCE_MODE=false

# ── Food Safety / cumplimiento de producto ───────────────────────────────────
REQUIRE_PRODUCT_COMPLIANCE=true
COMPLIANCE_EXEMPT_SKUS=

# ── Administración / GitHub ──────────────────────────────────────────────────
ADMIN_EMAILS=
OWNER_EMAILS=
STAFF_ROLES_JSON=
GITHUB_TOKEN=
GITHUB_REPO=appnutretium-hub/Nutretium
GITHUB_BRANCH=main

# ── Persistencia / Data Layer ─────────────────────────────────────────────────
# Mantener netlify-blobs hasta que exista un adaptador alternativo validado.
NUTRETIUM_STORAGE_PROVIDER=netlify-blobs
SITE_ID=
NETLIFY_API_TOKEN=
CONFIG_VAULT_KEY=

# Backup externo cifrado. Permanece opcional hasta configurar un destino HTTPS real.
# BACKUP_ENCRYPTION_KEY: 32 bytes aleatorios en base64, exclusiva para backups.
REQUIRE_OFFSITE_BACKUP=false
BACKUP_PROVIDER_URL=
BACKUP_PROVIDER_TOKEN=
BACKUP_PROVIDER_SECRET=
BACKUP_ENCRYPTION_KEY=
BACKUP_MAX_AGE_HOURS=36

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGIN=

# ── Email / Resend ────────────────────────────────────────────────────────────
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=
ORDER_EMAIL_FROM=
CONTACT_EMAIL=appnutretium@gmail.com

# ── Envíos ────────────────────────────────────────────────────────────────────
SHIPPING_ENABLED=false
SHIPPING_COUNTRY=España
SHIPPING_RATE_CENTS=
SHIPPING_FREE_FROM_CENTS=
SHIPPING_LABEL=Envío
SHIPPING_PROVIDER_URL=
SHIPPING_PROVIDER_TOKEN=
SHIPPING_PROVIDER_SECRET=
SHIPPING_PROVIDER_WEBHOOK_SECRET=

# ── Promociones / fidelización ────────────────────────────────────────────────
NUTRETIUM_COUPONS_JSON=
NUTRETIUM_POINTS_ENABLED=false
NUTRETIUM_POINTS_PER_EURO=

# ── Integraciones opcionales Enterprise ────────────────────────────────────────
RECURRING_PROVIDER_URL=
RECURRING_PROVIDER_TOKEN=
RECURRING_PROVIDER_SECRET=
SUBSCRIPTION_WORKER_ENABLED=false
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SMS_PROVIDER_SECRET=
WHATSAPP_PROVIDER_URL=
WHATSAPP_PROVIDER_TOKEN=
WHATSAPP_PROVIDER_SECRET=
PUSH_PROVIDER_URL=
PUSH_PROVIDER_TOKEN=
PUSH_PROVIDER_SECRET=
CRON_SECRET=

# ── Nutretium AI Control Plane ────────────────────────────────────────────────
AI_PROVIDER=deterministic
AI_EXTERNAL_SPEND_LIMIT_EUR=0
AI_PAID_PROVIDER_ENABLED=false
AUTO_RECHARGE_ENABLED=false
NETLIFY_AUTO_RECHARGE_ENABLED=false
AI_OLLAMA_QUEUE_ENABLED=false
AI_OLLAMA_RUNNER_TOKEN=
AI_OLLAMA_MODEL=
AI_ZERO_COST_SELF_HOSTED_ALLOWED=false
AI_OLLAMA_GATEWAY_URL=
AI_OLLAMA_GATEWAY_TOKEN=

# ── Federación IA Zero-Cost ──────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_FREE_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_FREE_TIER_CONFIRMED=false
GROQ_FREE_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_FREE_PLAN_CONFIRMED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKERS_FREE_PLAN_CONFIRMED=false
CLOUDFLARE_FREE_MODEL=@cf/zai-org/glm-4.7-flash
AGENT_MEMORY_HMAC_KEY=

# ── Variables que el código ya usaba y no estaban documentadas ────────────────
# Ninguna es obligatoria para vender: sin ellas, cada módulo se queda apagado o
# usa el valor indicado. Los secretos van SOLO en Netlify, nunca aquí.

# FACTUSOL (ERP). Sin credenciales el módulo responde NOT_CONFIGURED.
FACTUSOL_API_BASE_URL=
FACTUSOL_FABRICANTE_CODE=
FACTUSOL_CLIENTE_CODE=
FACTUSOL_DATABASE=
# Secreto: contraseña de la API de FACTUSOL.
FACTUSOL_PASSWORD=
# Ejercicio contable (por defecto, el año en curso).
FACTUSOL_EXERCISE=
FACTUSOL_TIMEOUT_MS=
# Almacenes a consultar, separados por comas, y tarifa de precios.
FACTUSOL_WAREHOUSE_CODES=
FACTUSOL_TARIFF_CODE=
# Lectura en directo del ERP y escritura en él: apagadas si no valen «true».
FACTUSOL_LIVE_ENABLED=false
FACTUSOL_WRITE_ENABLED=false

# TPVSOL: la sincronización solo se activa con las cuatro puestas.
# TPVSOL_SYNC_MODE = api | middleware
TPVSOL_SYNC_MODE=
TPVSOL_SYNC_ENDPOINT=
# Secreto: token del endpoint de sincronización.
TPVSOL_SYNC_TOKEN=
TPVSOL_CONNECTION_VALIDATED=false

# Alertas de operaciones. Sin ninguna de las dos se usa ORDER_NOTIFICATION_EMAIL.
OPS_ALERT_EMAIL=
OPS_ALERT_WEBHOOK_URL=
# Aviso de stock bajo (por defecto, ORDER_NOTIFICATION_EMAIL).
INVENTORY_NOTIFICATION_EMAIL=

# Antifraude: máximo de intentos de pago por cliente en 15 minutos (vacío = sin tope).
FRAUD_MAX_CHECKOUTS_15M=

# Dirección pública para los enlaces de los correos (por defecto https://nutretium.com).
PUBLIC_SITE_URL=

# Repositorio del panel de catálogo. Si está puesta MANDA sobre GITHUB_REPO:
# déjala vacía salvo que sepas por qué la necesitas.
GITHUB_REPOSITORY=

# Plantillas IA programadas: presupuesto por ciclo y topes de roles.
WORKFORCE_CYCLE_BUDGET_MS=
WORKFORCE_MAX_ROLES_PER_CYCLE=
WORKFORCE_MAX_MANUAL_FAMILY_ROLES=

# SOLO PRUEBAS: guarda todo en memoria. Nunca en Netlify (dentro de una función
# desplegada se ignora, pero no la pongas).
# NUTRETIUM_TEST_MEMORY_BLOBS=true
