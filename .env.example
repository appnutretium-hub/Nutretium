# NUTRETIUM — variables de entorno de producción
# Los valores reales van SOLO en Netlify → Site configuration → Environment variables.

# REDSYS / COBRO
REDSYS_SECRET_KEY=
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=1
REDSYS_ENV=test
COMMERCE_LIVE=false
URL_OK=
URL_KO=
MERCHANT_URL=

# AUTENTICACIÓN / ALMACENAMIENTO
JWT_SECRET=
NETLIFY_API_TOKEN=
ALLOWED_ORIGIN=

# ADMIN / BACK OFFICE
# Debe ser un correo privado distinto de CONTACT_EMAIL y ORDER_NOTIFICATION_EMAIL.
ADMIN_EMAILS=
GITHUB_TOKEN=
GITHUB_REPO=appnutretium-hub/Nutretium
GITHUB_BRANCH=main
# Ejemplo de formato, sin datos reales:
# STAFF_ROLES_JSON={"empleado@dominio.es":["orders","shipping","analytics"]}
STAFF_ROLES_JSON=

# EMAIL TRANSACCIONAL — RESEND
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=appnutretium@gmail.com
# Usar solo cuando nutretium.com esté verificado en Resend.
ORDER_EMAIL_FROM=Nutretium <pedidos@nutretium.com>
CONTACT_EMAIL=appnutretium@gmail.com

# ENVÍOS
# El checkout falla cerrado si SHIPPING_ENABLED no es true o falta la tarifa.
SHIPPING_ENABLED=false
SHIPPING_COUNTRY=España
# Importe en céntimos. Ejemplo: 395 = 3,95 €. Definir con la tarifa REAL contratada.
SHIPPING_RATE_CENTS=
# Opcional. Umbral real de envío gratuito, también en céntimos. Vacío = nunca gratis.
SHIPPING_FREE_FROM_CENTS=
SHIPPING_LABEL=Envío

# PROMOCIONES / FIDELIZACIÓN — opcionales
NUTRETIUM_COUPONS_JSON=
NUTRETIUM_POINTS_PER_EURO=
