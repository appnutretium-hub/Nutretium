# NUTRETIUM — plantilla de variables de entorno
# Los valores reales se configuran en Netlify → Site configuration → Environment variables.
# Nunca guardes secretos reales en el repositorio.

# ── Redsys ────────────────────────────────────────────────────────────────────
# Obligatorio para cobros reales. Mantener COMMERCE_LIVE=false hasta completar
# una prueba bancaria real de extremo a extremo.
REDSYS_SECRET_KEY=
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=1
REDSYS_ENV=test
URL_OK=
URL_KO=
MERCHANT_URL=
COMMERCE_LIVE=false

# ── Sesiones / seguridad ──────────────────────────────────────────────────────
# JWT_SECRET: mínimo 32 caracteres aleatorios.
JWT_SECRET=
# Opcional: secreto independiente para enlaces de seguimiento de invitados.
# Si queda vacío, guest-access usa JWT_SECRET. Para máxima segregación, definirlo.
GUEST_ORDER_SECRET=
MAINTENANCE_MODE=false

# ── Administración / GitHub ──────────────────────────────────────────────────
# ADMIN_EMAILS debe contener SOLO cuentas privadas de administración que no se
# publiquen como contacto de cliente.
ADMIN_EMAILS=
# Roles adicionales, en JSON, por email. Dejar vacío si no se usan.
STAFF_ROLES_JSON=
# Token fine-grained con acceso solo a este repo y Contents: read/write.
GITHUB_TOKEN=
GITHUB_REPO=appnutretium-hub/Nutretium
GITHUB_BRANCH=main

# ── Persistencia Netlify Blobs ────────────────────────────────────────────────
NETLIFY_API_TOKEN=

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGIN=

# ── Email / Resend ────────────────────────────────────────────────────────────
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=
# En producción usar un remitente @nutretium.com verificado en Resend.
ORDER_EMAIL_FROM=
CONTACT_EMAIL=appnutretium@gmail.com

# ── Envíos ────────────────────────────────────────────────────────────────────
# Fail-closed: no se anuncian/cobran envíos hasta activar y completar tarifa.
SHIPPING_ENABLED=false
SHIPPING_COUNTRY=España
SHIPPING_RATE_CENTS=
SHIPPING_FREE_FROM_CENTS=
SHIPPING_LABEL=Envío
SHIPPING_PROVIDER_URL=
SHIPPING_PROVIDER_TOKEN=
SHIPPING_PROVIDER_SECRET=
SHIPPING_PROVIDER_WEBHOOK_SECRET=

# ── Promociones / fidelización ────────────────────────────────────────────────
NUTRETIUM_COUPONS_JSON=
# El ratio NO activa Points por sí solo. Hace falta habilitarlo explícitamente.
NUTRETIUM_POINTS_ENABLED=false
NUTRETIUM_POINTS_PER_EURO=

# ── Integraciones opcionales Enterprise ───────────────────────────────────────
RECURRING_PROVIDER_URL=
RECURRING_PROVIDER_TOKEN=
RECURRING_PROVIDER_SECRET=
SUBSCRIPTION_WORKER_ENABLED=false
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SMS_PROVIDER_SECRET=
WHATSAPP_PROVIDER_URL=
WHATSAPP_PROVIDER_TOKEN=
WHATSAPP_PROVIDER_SECRET=
PUSH_PROVIDER_URL=
PUSH_PROVIDER_TOKEN=
PUSH_PROVIDER_SECRET=
CRON_SECRET=
