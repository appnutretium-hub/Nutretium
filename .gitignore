# Dependencias
node_modules/

# Artefacto público que genera scripts/prepare-dist.js en cada build.
dist/

# Páginas estáticas de SEO e informe del PIM: los genera
# scripts/build-seo-pages.js en cada build a partir de products-data.js, así
# que se rehacen solas y no se versionan. (Las carpetas sí se publican: las
# copia prepare-dist.js leyendo el disco, no git. `pim-audit.json` es interno
# y no se copia porque .json no está en la lista de extensiones públicas.)
/producto/
/categoria/
/marca/
/objetivo/
pim-audit.json

# Informe del auditor del sitio publicado (scripts/live-security-audit.js):
# es el resultado de una ejecución concreta, no código.
live-security-report.json

# Variables de entorno (nunca subir claves)
.env
.env.*
!.env.example

# Originales pesados e informes internos del catálogo:
# NO se publican en la web (se conservan solo en tu equipo).
sources/amix_fotos_categoria_nombre_pvp_FINAL_WEB/02_originales_renombradas_max_calidad/
sources/amix_fotos_categoria_nombre_pvp_FINAL_WEB/03_informes_control/

# Sistema
.DS_Store
Thumbs.db

# Documentos internos y fuentes: NO deben llegar al sitio publicado.
# (netlify.toml también los borra de la copia desplegada, por si el deploy
#  se hace sin pasar por git.)
Listado de stock disponible.pdf
CATALOGO_NUTRETIUM.xlsx
AUDITORIA_CATALOGO.md
GUIA_ARQUITECTURA_NETLIFY.md
PROMPT_SISTEMA_CLAUDE.md.md
_backup_pre_actualizacion/
test_write.txt
Nuevo Documento de texto.txt

# Originales de las fotos: pesan 8 MB y la web usa las recortadas de
# sources/productos/.
sources/01_PNG_MAX_CALIDAD_CON_PVP/
DESPLIEGUE.md
PRUEBAS_REDSYS.md

# Material de trabajo de la búsqueda de fotos (informes y hojas de contactos).
# netlify.toml ya borra 'scripts' de la copia desplegada; esto es para no
# llenar el repositorio de archivos temporales.
scripts/_*

# Buzón de fotos nuevas: las fotos sin tratar no van al repositorio, solo su
# instrucción. Las tratadas sí, en sources/productos/.
sources/_nuevas/*
!sources/_nuevas/LEEME.md
