# NUTRETIUM — plantilla de variables de entorno
# Los valores reales se configuran en Netlify → Site configuration → Environment variables.
# Nunca guardes secretos reales en el repositorio.

# ── Redsys ────────────────────────────────────────────────────────────────────
REDSYS_SECRET_KEY=
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=1
REDSYS_ENV=test
URL_OK=
URL_KO=
MERCHANT_URL=
COMMERCE_LIVE=false

# ── Sesiones / Security Core Zero Trust ───────────────────────────────────────
JWT_SECRET=
# MFA es obligatorio para owner/admin y para todo el personal en producción.
# Configura STAFF_TOTP_SECRETS antes del primer acceso privilegiado o aprovisiona
# la cuenta de forma segura. MFA_ENCRYPTION_KEY debe ser distinta de JWT_SECRET.
MFA_ENCRYPTION_KEY=
# Mapa JSON: {"correo@dominio":"SECRETO_BASE32"}. No se publica en el repositorio.
STAFF_TOTP_SECRETS=
REQUIRE_STAFF_MFA=true
# Cookie HttpOnly, CSRF y step-up se fuerzan automáticamente en producción.
REQUIRE_STAFF_COOKIE=false
REQUIRE_STAFF_CSRF=false
REQUIRE_STAFF_STEP_UP=false
GUEST_ORDER_SECRET=
MAINTENANCE_MODE=false

# ── Food Safety / cumplimiento de producto ───────────────────────────────────
# En producción el checkout exige aprobación y evidencia documental por SKU.
REQUIRE_PRODUCT_COMPLIANCE=true
# Solo para referencias no alimentarias con exención documentada (lista CSV).
COMPLIANCE_EXEMPT_SKUS=

# ── Administración / GitHub ──────────────────────────────────────────────────
ADMIN_EMAILS=
OWNER_EMAILS=
STAFF_ROLES_JSON=
GITHUB_TOKEN=
GITHUB_REPO=appnutretium-hub/Nutretium
GITHUB_BRANCH=main

# ── Persistencia Netlify Blobs / vault ────────────────────────────────────────
SITE_ID=
NETLIFY_API_TOKEN=
CONFIG_VAULT_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGIN=

# ── Email / Resend ────────────────────────────────────────────────────────────
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=
ORDER_EMAIL_FROM=
CONTACT_EMAIL=appnutretium@gmail.com

# ── Envíos ────────────────────────────────────────────────────────────────────
SHIPPING_ENABLED=false
SHIPPING_COUNTRY=España
SHIPPING_RATE_CENTS=
SHIPPING_FREE_FROM_CENTS=
SHIPPING_LABEL=Envío
SHIPPING_PROVIDER_URL=
SHIPPING_PROVIDER_TOKEN=
SHIPPING_PROVIDER_SECRET=
SHIPPING_PROVIDER_WEBHOOK_SECRET=

# ── Promociones / fidelización ────────────────────────────────────────────────
NUTRETIUM_COUPONS_JSON=
NUTRETIUM_POINTS_ENABLED=false
NUTRETIUM_POINTS_PER_EURO=

# ── Integraciones opcionales Enterprise ────────────────────────────────────────
RECURRING_PROVIDER_URL=
RECURRING_PROVIDER_TOKEN=
RECURRING_PROVIDER_SECRET=
SUBSCRIPTION_WORKER_ENABLED=false
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SMS_PROVIDER_SECRET=
WHATSAPP_PROVIDER_URL=
WHATSAPP_PROVIDER_TOKEN=
WHATSAPP_PROVIDER_SECRET=
PUSH_PROVIDER_URL=
PUSH_PROVIDER_TOKEN=
PUSH_PROVIDER_SECRET=
CRON_SECRET=

# ── Nutretium AI Control Plane ────────────────────────────────────────────────
# El análisis determinista permanece siempre disponible sin consumir APIs IA.
AI_PROVIDER=deterministic
AI_EXTERNAL_SPEND_LIMIT_EUR=0
AI_PAID_PROVIDER_ENABLED=false
AUTO_RECHARGE_ENABLED=false
NETLIFY_AUTO_RECHARGE_ENABLED=false

# Capa generativa gratuita con Ollama local. Netlify NO entra en el PC:
# el runner local consulta trabajos por HTTPS a nutretium.com y llama a
# Ollama exclusivamente en http://127.0.0.1:11434.
AI_OLLAMA_QUEUE_ENABLED=false
AI_OLLAMA_RUNNER_TOKEN=
AI_OLLAMA_MODEL=

# Compatibilidad con gateway HTTPS autohospedado. Sólo habilitar para
# infraestructura propia/autohospedada y nunca para un proveedor de pago.
AI_ZERO_COST_SELF_HOSTED_ALLOWED=false
AI_OLLAMA_GATEWAY_URL=
AI_OLLAMA_GATEWAY_TOKEN=

# ── Federación IA Zero-Cost ──────────────────────────────────────────────────
# Cada proveedor permanece apagado hasta tener credencial válida y confirmar
# explícitamente que la cuenta/proyecto usa su nivel gratuito. El consejo
# federado automático requiere al menos 2 proveedores habilitados.
GEMINI_API_KEY=
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_FREE_MODEL=gemini-3.8-flash

GROQ_API_KEY=
GROQ_FREE_TIER_CONFIRMED=false
GROQ_FREE_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=
OPENROUTER_FREE_PLAN_CONFIRMED=false

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKERS_FREE_PLAN_CONFIRMED=false
CLOUDFLARE_FREE_MODEL=@cf/zai-org/glm-4.7-flash

# Firma dedicada opcional para checkpoints. Si no existe, runtime deriva una
# subclave separada de JWT_SECRET; no reutiliza directamente la firma de sesión.
AGENT_MEMORY_HMAC_KEY=
